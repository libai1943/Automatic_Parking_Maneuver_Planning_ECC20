reset;
model NLP.mod;
include initial_guess0.INIVAL;
option solver ipopt;
solve;
printf "%d\n", solve_result_num > "solve_status.txt";
printf "%d\n", (if solve_result_num < 100 then 1 else 0) > "opti_flag.txt";
printf {i in I} "%.17g %.17g %.17g %.17g %.17g %.17g %.17g\n", x[i],y[i],theta[i],v[i],a[i],phy[i],w[i] > "trajectory.txt";
printf "%.17g\n", tf > "terminal_time.txt";
printf {i in I} "%.17g\n", x[i] > "x.txt";
printf {i in I} "%.17g\n", y[i] > "y.txt";
printf {i in I} "%.17g\n", theta[i] > "theta.txt";
printf {i in I} "%.17g\n", phy[i] > "phy.txt";
close;
